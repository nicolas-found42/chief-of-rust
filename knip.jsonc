{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Manual CLIs documented outside package.json and workflow run steps.
      "entry": [
        "scripts/orchestrator-loop-gate.mjs",
        "scripts/person-dossier-canary.mts",
        "scripts/person-research-benchmark.mts",
        "scripts/person-ambiguity-classification.mts",
        "scripts/person-benchmark-snapshot.mts",
        "scripts/run-debrief-eval-all.mts",
        "scripts/run-search-canaries.mjs",
        "scripts/run-canaries.mjs",
        "scripts/task-cutover.mts",
      ],
      "project": ["scripts/**/*.{js,mjs,mts,ts}"],
    },
    "apps/server": {
      "project": ["src/**/*.ts"],
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/shared": {
      "project": ["src/**/*.ts"],
    },
    "tests": {
      "entry": ["src/**/*.test.{ts,tsx}", "e2e/**/*.spec.ts", "e2e/start-server.mjs"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,mjs}"],
      // googleapis is a test double seam: the unit specs vi.mock it, but the
      // mock only binds when the tests workspace resolves the same module.
      "ignoreDependencies": ["googleapis"],
    },
    "relay": {
      "entry": ["src/server.ts"],
      "project": ["src/**/*.ts"],
    },
  },
}
