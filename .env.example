# Keep real values in your shell environment or a local .env (never committed).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-4
MISTRAL_REASONING_EFFORT=none
# Choose mistral, opencode, zai, ollama-cloud, or explicit offline mock.
LLM_PROVIDER=mistral
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Jev performs typed judgments, not prose generation. JEV_API_KEY overrides
# OPENROUTER_API_KEY; leave it empty to use the existing OpenRouter credential.
OPENROUTER_API_KEY=
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# Base before /v1/systemone. TYPESAFE_BASE_URL remains a native-install alias.
JEV_BASE_URL=https://openrouter.ai/api
OPENCODE_API_KEY=
OPENCODE_MODEL=gpt-6-luna
OPENCODE_REASONING_EFFORT=medium
# GPT models use Responses; choose a Responses-compatible model here.
OPENCODE_BASE_URL=https://opencode.ai/inference/go/v1
ZAI_API_KEY=
ZAI_MODEL=glm-5.3-flash
ZAI_REASONING_EFFORT=low
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=deepseek-v4.1-flash
OLLAMA_CLOUD_REASONING_EFFORT=high
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# Every configured search service is called. Docker supplies the bundled SearXNG URL.
# For native runs, set SEARXNG_BASE_URL to your SearXNG instance.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
# A web OAuth client; register http://localhost:5317/google/callback exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional outbound Task and public-video connections.
ASANA_ACCESS_TOKEN=
YOUTUBE_API_KEY=
HUBSPOT_ACCESS_TOKEN=
