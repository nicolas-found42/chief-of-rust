# Keep real values in your shell environment or a local .env (never committed).
MISTRAL_API_KEY=
# Meeting debriefs use Jev for evidence judgments via OpenRouter.
OPENROUTER_API_KEY=
# Generated text uses mistral-large-4. Jev does not generate prose.
LLM_PROVIDER=mistral
# A web OAuth client; register http://localhost:5317/google/callback exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional outbound Task and public-video connections.
ASANA_ACCESS_TOKEN=
YOUTUBE_API_KEY=
HUBSPOT_ACCESS_TOKEN=
