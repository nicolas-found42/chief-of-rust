# Keep real values in your shell environment or a local .env (never committed).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-4
MISTRAL_REASONING_EFFORT=low
# Choose mistral, opencode, zai, ollama-cloud, or explicit offline mock.
LLM_PROVIDER=opencode
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Jev performs typed judgments, not prose generation. JEV_API_KEY overrides
# OPENROUTER_API_KEY; leave it empty to use the existing OpenRouter credential.
OPENROUTER_API_KEY=
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# Base before /v1/systemone. TYPESAFE_BASE_URL remains a native-install alias.
JEV_BASE_URL=https://openrouter.ai/api
OPENCODE_API_KEY=
OPENCODE_MODEL=beam-free
OPENCODE_REASONING_EFFORT=medium
# GPT models use Responses; beam-free and other non-GPT models use Chat Completions.
OPENCODE_BASE_URL=https://opencode.ai/inference/go/v1
ZAI_API_KEY=
ZAI_MODEL=glm-5.3-flash
ZAI_REASONING_EFFORT=low
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=deepseek-v4.1-flash:1017
OLLAMA_CLOUD_REASONING_EFFORT=high
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# Every configured search service is called. Docker supplies the bundled SearXNG URL.
# For native runs, set SEARXNG_BASE_URL to your SearXNG instance.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
# A web OAuth client; register http://localhost:5317/google/callback exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional outbound Task and public-video connections.
ASANA_ACCESS_TOKEN=
YOUTUBE_API_KEY=
HUBSPOT_ACCESS_TOKEN=
# Optional per-service provider bases for those connections. Same seam as the
# collectors: HTTPS, or plain HTTP to a loopback host. The requested endpoint is
# still checked against that provider's allowlist, and OAuth token exchange is
# never redirected.
# CHIEF_COLLECT_GOOGLE_BASE=
# CHIEF_COLLECT_ASANA_BASE=
# CHIEF_COLLECT_HUBSPOT_BASE=
# Automatic Terminal installation budgets; no per-profile research controls.
TERMINAL_COLLECTION_SECONDS=600
TERMINAL_REQUEST_SECONDS=600
TERMINAL_MAX_ROUNDS=3
TERMINAL_MAX_SOURCES=80

# Opt in to the People Terminal beta after reviewing the workspace runbook.
PEOPLE_TERMINAL=false
