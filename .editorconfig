# Editor defaults matching what Prettier enforces, for the files it does not own.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Hand-wrapped prose: trailing whitespace is not meaningful, but wrapping is.
max_line_length = 100
