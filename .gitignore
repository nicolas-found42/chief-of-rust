# Rust build output.
/target/

.DS_Store

# The runtime data directory is the repo root one. Anchored: an unanchored
# rule would also swallow source directories named `workspace`.
/workspace/
/workspace.backup-*/

# Session handover notes. Local planning artifact.
previous-session.md

# Per-checkout Claude Code settings: local paths and permission grants, which
# belong to this machine rather than to the project. `launch.json` is shared.
.claude/settings.local.json

# Claude Code worktree checkouts: their .git files point back at the source
# checkout and must never enter this repo's history.
.claude/worktrees/

# Secrets. Nothing carrying a key is ever committed.
.env
.env.*
!.env.example

# Python bytecode from the scripts in `scripts/`.
__pycache__/
*.pyc

# Editor state. The four shared configs below are committed; anything else
# a local VS Code writes (history, workspace storage) stays ignored.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
